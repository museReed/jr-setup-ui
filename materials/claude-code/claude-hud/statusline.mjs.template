// claude-hud 的狀態列（Windows）。Claude Code 每 5 秒跑一次這支，並把一段 JSON 從
// stdin 餵進來，把 stdout 畫在輸入框下面。
//
// 為什麼是 node 而不是 PowerShell —— Windows VM 上一路踩出來的：
//
//   1. 整段塞進 settings.json 的一行 `powershell -Command "..."`：那一行同時有單引號、
//      $ 變數與一個帶空白的 node 路徑，而 Claude Code 會再經一層 shell，引號互相打架。
//   2. 改成 `powershell -File 一支 .ps1`：手動跑得出狀態列，Claude Code 裡仍然空白。
//      這台是 ARM64，powershell.exe 冷啟動要 1～2 秒，而狀態列每 5 秒跑一次——
//      合理的解釋是它根本來不及在 timeout 前把東西吐出來。
//
//   對照組：同一時間把指令換成 `cmd /c echo PROBE-OK`，狀態列當場出現 PROBE-OK。
//   所以機制是活的，慢的／被咬掉的是 PowerShell 那一層。
//
// node 本來就是硬需求（claude-hud 自己就是 node 跑的），拿它當入口：一個程序取代兩個、
// 啟動快一個數量級，而且指令裡只剩兩個被引號包好的絕對路徑，沒有東西需要跳脫。
//
// mac 那邊維持原本的一行 bash：那條實測是好的，而 bash 啟動本來就快，沒有理由跟著改。
import { spawnSync } from "node:child_process";
import { existsSync, readdirSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";

// Claude Code 會把子程序的 stdout 導向管線，所以 process.stdout.columns 讀不到——
// 只能靠環境變數，讀不到就退回 120。減 4 是留給輸入框左右各 2 欄（跟 mac 那支一樣）。
const columns = Number.parseInt(process.env.COLUMNS ?? "", 10);
const width = Number.isInteger(columns) && columns > 4 ? columns : 120;
process.env.COLUMNS = String(width - 4);

// cache 路徑第一層是 marketplace 名、第二層才是 plugin 名，中間那層不能省。
const configDir =
  process.env.CLAUDE_CONFIG_DIR ?? path.join(homedir(), ".claude");
const cacheRoot = path.join(configDir, "plugins", "cache");

// 版本資料夾可能有好幾個（升級過的機器）。取版本號最大、而且真的有 dist/index.js 的
// 那一個——所以 plugin 更新之後不用重跑安裝。
function newestEntry() {
  const found = [];

  for (const marketplace of listDirs(cacheRoot)) {
    const pluginDir = path.join(cacheRoot, marketplace, "claude-hud");

    for (const version of listDirs(pluginDir)) {
      if (!/^\d+(\.\d+)+$/.test(version)) {
        continue;
      }

      const entry = path.join(pluginDir, version, "dist", "index.js");

      if (existsSync(entry)) {
        found.push({ parts: version.split(".").map(Number), entry });
      }
    }
  }

  found.sort((a, b) => {
    const length = Math.max(a.parts.length, b.parts.length);

    for (let index = 0; index < length; index += 1) {
      const diff = (a.parts[index] ?? 0) - (b.parts[index] ?? 0);

      if (diff !== 0) {
        return diff;
      }
    }

    return 0;
  });

  return found.at(-1)?.entry ?? null;
}

function listDirs(dir) {
  try {
    return readdirSync(dir, { withFileTypes: true })
      .filter((item) => item.isDirectory())
      .map((item) => item.name);
  } catch {
    return [];
  }
}

const entry = newestEntry();

// 找不到就安靜結束。狀態列不該在學生的畫面上噴錯——那條沒出現本身就是訊號，
// 而錯誤訊息會被畫進輸入框下面，比空白更糟。
if (entry !== null) {
  // ⚠️ 這裡刻意 spawn 一個子程序，而不是在同一個程序裡 import。
  //
  // 少一個程序當然更快，但 dist/index.js 是別人打包出來的：CJS bundle 常用
  // `require.main === module` 判斷「我是不是被直接執行的那一支」來決定要不要跑主流程。
  // 用 import 載入時那個判斷是 false，於是什麼都不做——狀態列一樣空白，而且這種失敗
  // 完全不會有錯誤訊息。舊的寫法是 `node index.js`，那個判斷才成立。
  //
  // 我們控制不了那支 bundle 怎麼寫，也不該賭。stdio: "inherit" 讓 stdin/stdout 直接
  // 接到 Claude Code，跟舊行為一模一樣——換掉的只有 powershell 那一層。
  //
  // 代價是兩個 node 程序（各約 50 毫秒），仍然比 powershell 冷啟動的 1～2 秒快一個
  // 數量級，而那正是狀態列在 Windows 上不出現的原因。
  spawnSync(process.execPath, [entry], { stdio: "inherit" });
}
