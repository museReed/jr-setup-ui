powershell -NoProfile -Command "& { try { $w = $Host.UI.RawUI.WindowSize.Width; if ($w -gt 4) { $env:COLUMNS = $w - 4 } } catch { }; $dir = Get-ChildItem -Path (Join-Path $env:USERPROFILE '.claude\plugins\cache\*\claude-hud\*') -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^\d+(\.\d+)+$' -and (Test-Path (Join-Path $_.FullName 'dist\index.js')) } | Sort-Object { [version]$_.Name } | Select-Object -Last 1; if ($dir) { & '{RUNTIME}' (Join-Path $dir.FullName 'dist\index.js') } }"
