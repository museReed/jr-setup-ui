# claude-hud 的狀態列。Claude Code 每 5 秒跑一次這支，並把一段 JSON 從 stdin 餵進來。
#
# 為什麼是一支檔案，而不是 settings.json 裡的一行 `powershell -Command "..."`：
# 那一行要同時塞進單引號、$ 變數，還有一個帶空白的 node 路徑
# （C:\Program Files\nodejs\node.exe），而 Claude Code 在 Windows 上是把整條交給
# cmd.exe 再解析一次——引號互相打架，指令根本沒啟動。而 statusline 失敗是安靜的：
# 那一條不出現，沒有任何錯誤訊息（Windows VM 實測）。
#
# 這跟命名 hook 在 Windows 上的做法是同一招：powershell 藏在腳本檔裡，外面那層
# 只留一個 -File 路徑，沒有東西需要跳脫。
$ErrorActionPreference = 'SilentlyContinue'

# 留 4 欄給 Claude Code 自己的邊界，狀態列才不會被截斷。
try {
  $width = $Host.UI.RawUI.WindowSize.Width
  if ($width -gt 4) { $env:COLUMNS = $width - 4 }
} catch { }

# 設定家目錄可以被 CLAUDE_CONFIG_DIR 換掉，跟 mac 那支同一個判斷。
$configDir = if ($env:CLAUDE_CONFIG_DIR) {
  $env:CLAUDE_CONFIG_DIR
} else {
  Join-Path $env:USERPROFILE '.claude'
}

# cache 路徑第一層是 marketplace 名、第二層才是 plugin 名，中間那層不能省。
# 版本資料夾可能有好幾個（升級過的機器），取版本號最大而且真的有 dist\index.js 的那個。
$dir = Get-ChildItem -Path (Join-Path $configDir 'plugins\cache\*\claude-hud\*') -Directory |
  Where-Object {
    $_.Name -match '^\d+(\.\d+)+$' -and
    (Test-Path (Join-Path $_.FullName 'dist\index.js'))
  } |
  Sort-Object { [version]$_.Name } |
  Select-Object -Last 1

if (-not $dir) { return }

& '{RUNTIME}' (Join-Path $dir.FullName 'dist\index.js')
