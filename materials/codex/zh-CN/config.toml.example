# Codex CLI — Workshop 建议设定
# 把下面几行加到你的 ~/.codex/config.toml 最上方
#
# personality：控制 AI 的基本语气
#   "pragmatic" — 务实简洁（推荐，和 Output Style 最搭）
#   "friendly"  — 友善、解释多一点
#   "none"      — 不注入任何人格，完全靠 AGENTS.md 控制
#
# instructions：每次开 session 都注入的 system prompt 片段
#   这行让 Codex 被提醒遵守 AGENTS.md 的回复规则。
#   没有这行的话，Codex 可能几轮对话后就退回默认语气。
#
# sandbox_mode / approval_policy：Codex 的 Auto 模式，等同 Claude Code 的
# acceptEdits——工作区内的文件修改自动套用，不必逐次接受；超出工作区、动网络或
# 高风险操作才会停下来问你。
#   sandbox_mode    "workspace-write"    工作区内可写（课堂用这个）
#                   "danger-full-access" 整台机器都能动，不要用
#   approval_policy "on-request"         需要时才问（课堂用这个）
#                   "never"              什么都不问，连工作区外也不问，不要用

personality = "pragmatic"
instructions = "回复必须严格遵守 AGENTS.md 的 Output Style 规则：结论先行（粗体）、3-5 bullet、比较用表格、不用 emoji/庆祝语气、中等长度不灌水、白话原则。每次回复前自检。"
sandbox_mode = "workspace-write"
approval_policy = "on-request"
