# Codex CLI — Workshop 建议设定
# 把下面几行加到你的 ~/.codex/config.toml 最上方
#
# personality：控制 AI 的基本语气
#   "pragmatic" — 务实简洁（推荐，和 Output Style 最搭）
#   "friendly"  — 友善、解释多一点
#   "none"      — 不注入任何人格，完全靠 AGENTS.md 控制
#
# instructions：每次开 session 都注入的 system prompt 片段
#   这行让 Codex 被提醒遵守 AGENTS.md 的回复规则。
#   没有这行的话，Codex 可能几轮对话后就退回默认语气。
#
# default_permissions / approval_policy：Codex 的 Auto 模式，等同 Claude Code 的
# acceptEdits——工作区内的文件修改自动套用，不必逐次接受；超出工作区、动网络或
# 高风险操作才会停下来问你。
#   default_permissions ":read-only"          只读，什么都不能改（不设时的默认）
#                       ":workspace"          工作区内可写（课堂用这个）
#                       ":danger-full-access" 整台机器与网络都不设限，不要用
#
# ⚠️ 不要再用旧的 sandbox_mode：官方文件明说两者不能并存，而且旧 key 设了之后
# Codex 的权限选单仍然停在「Read Only」——新的 default_permissions 没设就走它自己的
# 默认，旧的那个等于白设（Windows VM 实测）。
#   approval_policy "untrusted"          有风险的操作才问
#                   "on-request"         需要时才问（课堂用这个）
#                   "never"              什么都不问，连工作区外也不问，不要用
#                   "granular"           分类逐项设定，课堂用不到
#
# approvals_reviewer：上面那行决定「什么时候需要批准」，这行决定「谁来批准」。
# 两个是独立的旋钮——只设 approval_policy 的话，该问的还是会跳出来问你。
#   "user"        默认，跳出来问你
#   "auto_review" 交给一个审核 agent 判断（课堂用这个）
# 它只换审核者，不动沙盒边界：工作区外的写入照样被 workspace-write 挡着。
# 也就是说这是「少问」不是「放行」——而且做判断的是一个模型，不是规则式的白名单。

personality = "pragmatic"
instructions = "回复必须严格遵守 AGENTS.md 的 Output Style 规则：结论先行（粗体）、3-5 bullet、比较用表格、不用 emoji/庆祝语气、中等长度不灌水、白话原则。每次回复前自检。"
default_permissions = ":workspace"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
