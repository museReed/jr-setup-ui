# Codex CLI — Workshop Recommended Settings
# Add the lines below to the top of your ~/.codex/config.toml
#
# personality: Controls the AI's base tone
#   "pragmatic" — concise and direct (recommended, pairs best with Output Style)
#   "friendly"  — warmer, more explanatory
#   "none"      — no personality injection, fully controlled by AGENTS.md
#
# instructions: System prompt snippet injected every session
#   This reminds Codex to follow AGENTS.md response rules.
#   Without it, Codex may revert to default tone after a few turns.
#
# default_permissions / approval_policy: Codex's Auto mode, the counterpart to
# Claude Code's acceptEdits. File edits inside the workspace apply without
# asking; going outside it, touching the network, or anything risky still
# prompts.
#   default_permissions ":read-only"          nothing can be changed (the default)
#                       ":workspace"          writable in the workspace (use this)
#                       ":danger-full-access" no limits at all; do not use
#
# WARNING: do not use the older sandbox_mode. The docs say the two must not be
# combined, and with only the old key set Codex's permission selector still
# reads "Read Only" — default_permissions falls back to its own default and the
# old key does nothing (verified on a Windows VM).
#   approval_policy "untrusted"          asks only for risky operations
#                   "on-request"         asks only when needed (use this)
#                   "never"              never asks, not even outside the
#                                        workspace; do not use
#                   "granular"           per-category switches; not needed here
#
# approvals_reviewer: the line above decides *when* approval is needed; this one
# decides *who* approves. They are independent knobs — setting only
# approval_policy still leaves the prompts coming to you.
#   "user"        default; prompts you
#   "auto_review" hands the decision to a reviewer agent (use this)
# It only swaps the reviewer, not the sandbox boundary: writes outside the
# workspace are still blocked by workspace-write. So this means "asks less",
# not "allowed more" — and the thing deciding is a model, not a rule list.

personality = "pragmatic"
instructions = "Strictly follow the Output Style rules in AGENTS.md: conclusion first (bold), 3-5 bullets, comparisons in tables, no emoji/celebratory tone, medium length, plain language principle. Self-check before every response."
default_permissions = ":workspace"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
